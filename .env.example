# Postgres
POSTGRES_USER=fhir
POSTGRES_PASSWORD=fhir
POSTGRES_DB=fhir

# App
DATABASE_URL=postgresql+psycopg://fhir:fhir@db:5432/fhir
CORS_ORIGINS=*
LOG_FILE=
FHIR_RESOURCE_TYPES=
JWT_SECRET=replace-with-output-of--python-c--import-secrets-print-secrets.token_hex-32
JWT_EXPIRY_MINUTES=60
# Set to true in production when NGINX (or another reverse proxy) terminates TLS.
# Requests arriving with X-Forwarded-Proto: http will be rejected with 403.
REQUIRE_HTTPS=false

# Redis
REDIS_URL=redis://redis:6379/0

# Integration tests
# Base URL of the running FHIR server targeted by integration tests.
FHIR_BASE_URL=https://localhost
# Set to true when the server certificate is CA-signed (e.g. in CI).
# Leave false for local development with a self-signed certificate.
FHIR_SSL_VERIFY=false
# Supply a pre-existing bearer token to skip the auto-register/login step.
FHIR_JWT_TOKEN=

# Unit tests
# Set to true to run unit tests against a real Postgres instance instead of SQLite.
USE_POSTGRES=false
